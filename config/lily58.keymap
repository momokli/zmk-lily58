 *
 * Lily58 QWERTZ Gaming Layout (left half only)
 * ==============================================
 * Designed for a gamer new to split keyboards.
 *
 * IMPORTANT QWERTZ NOTE:
 * On German QWERTZ, Z and Y are physically swapped vs QWERTY.
 * In ZMK HID codes: &kp Z = physical Z position → QWERTZ outputs 'Y'
 *                   &kp Y = physical Y position → QWERTZ outputs 'Z'
 *
 * Default Layer: Standard QWERTZ left half — for typing/learning
 * Lower  Layer: Gaming F-keys (F1-F12) + media controls
 * Raise  Layer: Gaming extras (Z key, arrows, symbols)
 *
 * Thumb cluster (default): LALT | LOWER(hold) | SPACE | RAISE(hold)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ===================================================================
         * DEFAULT LAYER — Standard QWERTZ (left half)
         * ┌──────┬─────┬─────┬─────┬─────┬─────┐
         * │ ESC  │  1  │  2  │  3  │  4  │  5  │
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │ TAB  │  Q  │  W  │  E  │  R  │  T  │
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │LCTRL │  A  │  S  │  D  │  F  │  G  │
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │LSHFT │  Y  │  X  │  C  │  V  │  B  │ ← Y = &kp Z (QWERTZ swap)
         * └──────┴─────┴─────┴─────┴─────┴─────┘
         *      ┌──────┬──────┬──────┬──────┐
         *      │ LALT │LOWER │ SPACE│ RAISE│
         *      └──────┴──────┴──────┴──────┘
         *
         * Hold LOWER → gaming function keys layer
         * Hold RAISE → Z key, navigation, symbols layer
         * =================================================================== */
        default_layer {
            bindings = <
                &kp ESC   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5
                &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T
                &kp LCTRL &kp A    &kp S    &kp D    &kp F    &kp G
                &kp LSHFT &kp Z    &kp X    &kp C    &kp V    &kp B
                              &kp LALT &mo 1   &kp SPACE &mo 2
            >;
        };

        /* ===================================================================
         * LOWER LAYER — Gaming F-Keys & Media Controls
         * Hold LOWER (inner thumb) to access.
         * ┌──────┬─────┬─────┬─────┬─────┬─────┐
         * │  F1  │ F2  │ F3  │ F4  │ F5  │ F6  │
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │  F7  │ F8  │ F9  │ F10 │ F11 │ F12 │
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │ VOL- │ VOL+│ MUTE│PLAY │ PREV│ NEXT│
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │trans │trans│trans│trans│trans│trans│ ← bottom row still works
         * └──────┴─────┴─────┴─────┴─────┴─────┘
         *      ┌──────┬──────┬──────┬──────┐
         *      │trans │ trans│ trans│ trans│ ← thumbs still work
         *      └──────┴──────┴──────┴──────┘
         * =================================================================== */
        lower_layer {
            bindings = <
                &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6
                &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
                &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &kp C_PP  &kp C_PREV  &kp C_NEXT
                &trans     &trans     &trans     &trans     &trans     &trans
                              &trans     &trans     &trans     &trans
            >;
        };

        /* ===================================================================
         * RAISE LAYER — Gaming Extras (Z, Arrows, Symbols)
         * Hold RAISE (inner thumb) to access.
         * ┌──────┬─────┬─────┬─────┬─────┬─────┐
         * │  `   │  1  │  2  │  3  │  4  │  5  │
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │ ESC  │  Z  │  W  │  E  │  R  │  T  │ ← Z = &kp Y (QWERTZ swap)
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │ LEFT │DOWN │ UP  │RIGHT│HOME │ END │ ← arrow/nav cluster
         * ├──────┼─────┼─────┼─────┼─────┼─────┤
         * │ LGUI │CAPS │  -  │  =  │  [  │  ]  │ ← symbols + Win key
         * └──────┴─────┴─────┴─────┴─────┴─────┘
         *      ┌──────┬──────┬──────┬──────┐
         *      │trans │ trans│ trans│ trans│ ← thumbs still work
         *      └──────┴──────┴──────┴──────┘
         * =================================================================== */
        raise_layer {
            bindings = <
                &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
                &kp ESC    &kp Y     &kp W     &kp E     &kp R     &kp T
                &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT &kp HOME  &kp END
                &kp LGUI   &kp CAPS  &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT
                              &trans   &trans    &trans    &trans
            >;
        };
    };
};
